<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <Target Name="CopyFiles" AfterTargets="AfterBuild">
        <Copy SourceFiles=".env" DestinationFolder="$(OutputPath)"/>
        <Copy SourceFiles="config\appsettings.json" DestinationFolder="$(OutputPath)config\"/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0-preview.5.25277.114"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0-preview.5.25277.114"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0-preview.5.25277.114"/>

        <PackageReference Include="EchoChat.Core" Version="0.0.1-dev-00001"/>

    </ItemGroup>

    <ItemGroup>
        <Folder Include="obj\"/>
    </ItemGroup>


</Project>
